{
  // Terminal > Görevi Çalıştır... (Ctrl+Shift+P → "Tasks: Run Task")
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bağımlılıkları kur (npm install)",
      "type": "npm",
      "script": "install",
      "problemMatcher": []
    },
    {
      "label": "Geliştirme sunucusu (npm run dev)",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": { "regexp": "^x^" },
        "background": {
          "activesBegin": ".*Next\.js.*",
          "beginsPattern": ".*Next\.js.*",
          "endsPattern": ".*Ready in.*"
        }
      }
    },
    {
      "label": "Üretim derlemesi (npm run build)",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Derlenmiş siteyi önizle (npm run preview)",
      "type": "npm",
      "script": "preview",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Tip kontrolü (npm run typecheck)",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": ["$tsc"]
    }
  ]
}
