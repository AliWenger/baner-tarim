# Sitenin canlı adresi (sitemap, Open Graph ve canonical URL'ler için).
# GitHub Actions bunu otomatik ayarlar; yerelde gerekmez.
NEXT_PUBLIC_SITE_URL=https://kullanici.github.io

# Site alt klasörde yayınlanıyorsa (ör. /baner-tarim). Kök alan adında boş.
NEXT_PUBLIC_BASE_PATH=

# İletişim formu: mesajların JSON olarak gönderileceği adres.
# Ücretsiz Formspree: https://formspree.io → yeni form → "https://formspree.io/f/xxxx"
# GitHub'da: Settings → Secrets and variables → Actions → Variables →
#   CONTACT_ENDPOINT adında değişken olarak ekleyin.
NEXT_PUBLIC_CONTACT_ENDPOINT=
